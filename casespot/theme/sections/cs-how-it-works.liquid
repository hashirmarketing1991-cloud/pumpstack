{{ 'cs-privacy.css' | asset_url | stylesheet_tag }}

<section class="cs cs-how" aria-label="{{ section.settings.heading | escape }}">
  <div class="cs-wrap">
    <div class="cs-head">
      {%- if section.settings.eyebrow != blank -%}<p class="cs-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="cs-h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="cs-lead">{{ section.settings.text }}</p>{%- endif -%}
    </div>

    <div class="cs-how__grid">
      <div class="cs-how__visual">
        {%- if section.settings.video_url != blank -%}
          <div class="cs-media cs-how__video">
            <video autoplay muted loop playsinline controls preload="metadata"{% if section.settings.image %} poster="{{ section.settings.image | image_url: width: 1000 }}"{% endif %}>
              <source src="{{ section.settings.video_url }}" type="video/mp4">
            </video>
          </div>
        {%- elsif section.settings.image -%}
          <div class="cs-media cs-how__video">
            {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 45vw, 100vw', widths: '500, 800, 1200', alt: section.settings.heading }}
          </div>
        {%- endif -%}
      </div>

      <ol class="cs-how__steps">
        {%- for block in section.blocks -%}
          <li class="cs-how__step" {{ block.shopify_attributes }}>
            <span class="cs-how__n" aria-hidden="true">{{ forloop.index }}</span>
            <div>
              <h3 class="cs-h3">{{ block.settings.title }}</h3>
              <p>{{ block.settings.text }}</p>
            </div>
          </li>
        {%- endfor -%}
        {%- if section.settings.cta_label != blank -%}
          <li class="cs-how__cta"><a class="cs-btn" href="#buy">{{ section.settings.cta_label }}</a></li>
        {%- endif -%}
      </ol>
    </div>
  </div>
</section>

<style>
  html .cs-how__grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 36px; align-items: center; }
  html .cs-how__video { aspect-ratio: 4 / 5; background: #111; }
  html .cs-how__video video { object-fit: cover; }
  html .cs-how__steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; }
  html .cs-how__step { position: relative; display: flex; gap: 18px; align-items: flex-start; padding: 22px 22px; border: 1px solid var(--cs-line); border-radius: var(--cs-radius); background: #fff; }
  html .cs-how__step p { margin-top: 6px; font-size: 15px; }
  html .cs-how__n { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; background: var(--cs-ink); color: #fff; font-size: 17px; font-weight: 800; flex: none; }
  html .cs-how__step:first-child .cs-how__n { background: var(--cs-accent); }
  html .cs-how__cta { margin-top: 12px; }
  @media (min-width: 990px) {
    html .cs-how__grid { grid-template-columns: .85fr 1.15fr; gap: 72px; }
    html .cs-how__step { padding: 26px 28px; }
  }
  @media (max-width: 749px) { html .cs-how__video { aspect-ratio: 1 / 1; } }
</style>

{% schema %}
{
  "name": "CS How it works",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Easy install at home" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "On your phone in 60 seconds. No shop visit." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "The auto-align kit does the hard part. No bubbles, no dust, no crooked edges." },
    { "type": "text", "id": "video_url", "label": "Install video URL (.mp4)", "info": "Upload in Content > Files and paste the link." },
    { "type": "image_picker", "id": "image", "label": "Image or video cover" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Order my kit" }
  ],
  "blocks": [
    {
      "type": "step", "name": "Step",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Clean" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Wipe the screen." }
      ]
    }
  ],
  "presets": [
    {
      "name": "CS How it works",
      "blocks": [
        { "type": "step", "settings": { "title": "Clean the screen", "text": "Use the wet wipe, then the dry cloth. Lift any last dust with a dust sticker." } },
        { "type": "step", "settings": { "title": "Place your iPhone in the kit", "text": "The frame holds your phone in exactly the right spot. Nothing to line up by eye." } },
        { "type": "step", "settings": { "title": "Pull the tab and press", "text": "The glass drops straight into place. Press from the centre out and you are done." } }
      ]
    }
  ]
}
{% endschema %}
