{{ 'cs-privacy.css' | asset_url | stylesheet_tag }}

<section class="cs cs-how" aria-label="{{ section.settings.heading | escape }}">
  <div class="cs-wrap">
    <div class="cs-head">
      {%- if section.settings.eyebrow != blank -%}<p class="cs-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="cs-h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="cs-lead">{{ section.settings.text }}</p>{%- endif -%}
    </div>

    <ol class="cs-how__steps">
      {%- for block in section.blocks -%}
        <li class="cs-how__step" {{ block.shopify_attributes }}>
          {%- if block.settings.image -%}
            <div class="cs-media cs-how__img">
              {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 33vw, 100vw', widths: '400, 600, 900', alt: block.settings.title }}
            </div>
          {%- endif -%}
          <span class="cs-how__n" aria-hidden="true">{{ forloop.index }}</span>
          <h3 class="cs-h3">{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </li>
      {%- endfor -%}
    </ol>

    {%- if section.settings.video != blank -%}
      <div class="cs-media cs-how__video">{{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true }}</div>
    {%- endif -%}

    {%- if section.settings.cta_label != blank -%}
      <p class="cs-center cs-how__cta"><a class="cs-btn" href="#buy">{{ section.settings.cta_label }}</a></p>
    {%- endif -%}
  </div>
</section>

<style>
  .cs-how__steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 22px; counter-reset: step; }
  .cs-how__step { position: relative; padding: 26px 24px; border: 1px solid var(--cs-line); border-radius: var(--cs-radius); background: #fff; }
  .cs-how__step p { margin: 0; font-size: 15px; }
  .cs-how__img { aspect-ratio: 4 / 3; margin: -10px -10px 20px; }
  .cs-how__n { display: grid; place-items: center; width: 40px; height: 40px; margin: 0 0 14px; border-radius: 50%; background: var(--cs-accent); color: #fff; font-weight: 900; }
  .cs-how__video { margin-top: 32px; aspect-ratio: 16 / 9; }
  .cs-how__video video { width: 100%; height: 100%; object-fit: cover; display: block; }
  .cs-how__cta { margin: 36px 0 0; }
  @media (min-width: 990px) { .cs-how__steps { grid-template-columns: repeat(3, 1fr); } }
</style>

{% schema %}
{
  "name": "CS How it works",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Easy to install at home" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "On your phone in 2 minutes. No store visit." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "The auto-align kit does the hard part. If you can put a sticker on straight, you can do this." },
    { "type": "video", "id": "video", "label": "Install video (optional)" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Protect my screen" }
  ],
  "blocks": [
    {
      "type": "step", "name": "Step",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Clean" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Wipe the screen." }
      ]
    }
  ],
  "presets": [
    {
      "name": "CS How it works",
      "blocks": [
        { "type": "step", "settings": { "title": "Clean the screen", "text": "Use the wet wipe, then the dry cloth. Lift any last dust with a dust sticker." } },
        { "type": "step", "settings": { "title": "Drop it in the frame", "text": "Set your phone in the auto-align frame, peel the film and let the glass fall into place." } },
        { "type": "step", "settings": { "title": "Press and done", "text": "Press from the center out. Full glue bonds the whole surface, so there are no bubbles or halo edges." } }
      ]
    }
  ]
}
{% endschema %}
