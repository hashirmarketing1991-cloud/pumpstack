{{ 'cs-privacy.css' | asset_url | stylesheet_tag }}

<section class="cs cs--soft cs-feat" aria-label="{{ section.settings.heading | escape }}">
  <div class="cs-wrap">
    <div class="cs-head">
      {%- if section.settings.eyebrow != blank -%}<p class="cs-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="cs-h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="cs-lead">{{ section.settings.text }}</p>{%- endif -%}
    </div>

    <div class="cs-feat__grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'card' -%}
          <article class="cs-feat__card" {{ block.shopify_attributes }}>
            {%- if block.settings.image -%}
              <div class="cs-media cs-feat__img">
                {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 25vw, (min-width: 750px) 50vw, 100vw', widths: '400, 600, 900', alt: block.settings.title }}
              </div>
            {%- else -%}
              <div class="cs-feat__num" aria-hidden="true">0{{ forloop.index }}</div>
            {%- endif -%}
            <h3 class="cs-h3">{{ block.settings.title }}</h3>
            <p>{{ block.settings.text }}</p>
          </article>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- if section.settings.chips != blank -%}
      {%- assign chips = section.settings.chips | split: ',' -%}
      <ul class="cs-chips cs-feat__chips" aria-label="All features">
        {%- for c in chips -%}<li>{{ c | strip }}</li>{%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

<style>
  .cs-feat__grid { display: grid; gap: 18px; }
  .cs-feat__card { padding: 22px; border-radius: var(--cs-radius); background: #fff; box-shadow: var(--cs-shadow); }
  .cs-feat__card p { margin: 0; font-size: 15px; }
  .cs-feat__img { aspect-ratio: 4 / 3; margin: -8px -8px 18px; }
  .cs-feat__num { display: grid; place-items: center; width: 52px; height: 52px; margin: 0 0 16px; border-radius: 14px; background: var(--cs-ink); color: #fff; font-weight: 900; }
  .cs-feat__chips { margin-top: 40px; }
  @media (min-width: 750px) { .cs-feat__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 990px) { .cs-feat__grid { grid-template-columns: repeat(4, 1fr); } }
</style>

{% schema %}
{
  "name": "CS Features",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Why it stands out" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Privacy you can feel. Protection you forget is there." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Most privacy glass makes your screen look dim and cheap. This one keeps it bright and sharp for you, and dark for everyone else." },
    { "type": "textarea", "id": "chips", "label": "Feature tags (comma separated)", "default": "Anti-spy, Anti-scratch 9H, Anti-fingerprint, Anti-glare, Shatter resistant, Shock absorbing, Full glue, Full coverage, Oil resistant, Dust resistant, Water resistant, Ultra-thin, Bubble free, HD clear" }
  ],
  "blocks": [
    {
      "type": "card", "name": "Feature card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Privacy redefined" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Clear from the front, dark from the side." }
      ]
    }
  ],
  "presets": [
    {
      "name": "CS Features",
      "blocks": [
        { "type": "card", "settings": { "title": "Privacy redefined", "text": "Micro-louver glass lets light through straight ahead and blocks it from the side. Face it and it is clear. Anyone beside you sees a black screen." } },
        { "type": "card", "settings": { "title": "Tough 9H glass", "text": "Tempered glass takes the scratches, drops and keys in your pocket, so your real screen does not have to." } },
        { "type": "card", "settings": { "title": "Fits your exact model", "text": "Cut for your iPhone, with cutouts for the speaker and camera. Works with Face ID and most cases." } },
        { "type": "card", "settings": { "title": "Thin and smooth", "text": "Ultra-thin with an oil-resistant coating. Touch feels the same, and fingerprints wipe right off." } }
      ]
    }
  ]
}
{% endschema %}
