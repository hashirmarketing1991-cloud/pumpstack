{{ 'cs-privacy.css' | asset_url | stylesheet_tag }}

<section class="cs cs--soft cs-feat" aria-label="{{ section.settings.heading | strip_html | escape }}">
  <div class="cs-wrap">
    <div class="cs-head">
      {%- if section.settings.eyebrow != blank -%}<p class="cs-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="cs-h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="cs-lead">{{ section.settings.text }}</p>{%- endif -%}
    </div>

    <div class="cs-feat__grid">
      {%- for block in section.blocks -%}
        <article class="cs-feat__card" {{ block.shopify_attributes }}>
          <span class="cs-feat__icon" aria-hidden="true">
            {%- case block.settings.icon -%}
              {%- when 'eye' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.9 17.9A10 10 0 0 1 12 20C5 20 1 12 1 12a18 18 0 0 1 5.1-5.9M9.9 4.2A9 9 0 0 1 12 4c7 0 11 8 11 8a18 18 0 0 1-2.2 3.2M1 1l22 22"/></svg>
              {%- when 'diamond' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h12l4 6-10 12L2 9z"/><path d="M2 9h20M12 21L8 9l4-6 4 6z"/></svg>
              {%- when 'touch' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11V6a2 2 0 0 1 4 0v5M13 10a2 2 0 0 1 4 0v1.5M17 11a2 2 0 0 1 4 0v4a7 7 0 0 1-7 7h-1.5a7 7 0 0 1-5.6-2.8L3.5 15.5a2 2 0 0 1 3-2.6L9 15"/></svg>
              {%- when 'sun' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
              {%- else -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l8 4v6c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V6z"/></svg>
            {%- endcase -%}
          </span>
          <h3 class="cs-h3">{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </article>
      {%- endfor -%}
    </div>

    <div class="cs-feat__row">
      {%- if section.settings.image -%}
        <div class="cs-media cs-feat__img">
          {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 50vw, 100vw', widths: '500, 800, 1100, 1400', alt: section.settings.row_heading }}
        </div>
      {%- endif -%}
      <div class="cs-feat__rowcopy">
        <h3 class="cs-h2 cs-feat__rowh">{{ section.settings.row_heading }}</h3>
        {%- if section.settings.row_text != blank -%}<p class="cs-lead">{{ section.settings.row_text }}</p>{%- endif -%}
        {%- if section.settings.chips != blank -%}
          {%- assign chips = section.settings.chips | split: ',' -%}
          <ul class="cs-feat__chips" aria-label="All features">
            {%- for c in chips -%}<li>{{ c | strip }}</li>{%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

<style>
  html .cs-feat__grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 16px; }
  html .cs-feat__card { padding: 28px 26px; border-radius: var(--cs-radius); background: #fff; box-shadow: var(--cs-shadow); }
  html .cs-feat__card p { margin-top: 8px; font-size: 15px; line-height: 1.6; }
  html .cs-feat__icon { display: grid; place-items: center; width: 50px; height: 50px; margin-bottom: 20px; border-radius: 14px; background: #fdeee8; color: var(--cs-accent); }
  html .cs-feat__icon svg { width: 24px; height: 24px; }
  html .cs-feat__row { display: grid; grid-template-columns: minmax(0, 1fr); gap: 32px; align-items: center; margin-top: 64px; }
  html .cs-feat__img { aspect-ratio: 3 / 2; }
  html .cs .cs-feat__rowh { font-size: clamp(26px, 3vw, 36px); margin-bottom: 14px; }
  html .cs-feat__chips { display: flex; flex-wrap: wrap; gap: 8px; margin: 24px 0 0; padding: 0; list-style: none; }
  html .cs-feat__chips li { padding: 9px 14px; border-radius: 999px; background: #fff; border: 1px solid var(--cs-line); color: var(--cs-ink); font-size: 14px; font-weight: 600; line-height: 1.2; }
  @media (min-width: 750px) { html .cs-feat__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 990px) {
    html .cs-feat__grid { grid-template-columns: repeat(4, 1fr); gap: 20px; }
    html .cs-feat__row { grid-template-columns: 1.1fr .9fr; gap: 72px; margin-top: 88px; }
  }
</style>

{% schema %}
{
  "name": "CS Features",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Why CaseSpot privacy glass" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Privacy you notice. Protection you forget is there." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Cheap privacy glass makes your screen dim and grainy. Ours stays bright and sharp for you, and dark for everyone else." },
    { "type": "image_picker", "id": "image", "label": "Row image" },
    { "type": "text", "id": "row_heading", "label": "Row heading", "default": "Works without an app or setting" },
    { "type": "textarea", "id": "row_text", "label": "Row text", "default": "Tiny vertical louvers inside the glass let light straight through to your eyes and block it from the sides. Nothing to switch on. It just works." },
    { "type": "textarea", "id": "chips", "label": "Feature tags (comma separated)", "default": "Anti-spy, 9H hardness, Anti-fingerprint, Anti-glare, Shatter resistant, Shock absorbing, Full glue, Full coverage, Oil resistant, Dust resistant, Water resistant, Ultra-thin, Bubble free, HD clear" }
  ],
  "blocks": [
    {
      "type": "card", "name": "Feature card",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "eye", "options": [ { "value": "eye", "label": "Privacy" }, { "value": "diamond", "label": "Glass" }, { "value": "touch", "label": "Touch" }, { "value": "sun", "label": "Clarity" }, { "value": "shield", "label": "Shield" } ] },
        { "type": "text", "id": "title", "label": "Title", "default": "Privacy protection" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Clear from the front, dark from the side." }
      ]
    }
  ],
  "presets": [
    {
      "name": "CS Features",
      "blocks": [
        { "type": "card", "settings": { "icon": "eye", "title": "Blocks side views", "text": "Face it and it is clear. Anyone beside you sees a dark screen. Perfect for buses, offices and queues." } },
        { "type": "card", "settings": { "icon": "diamond", "title": "9H tempered glass", "text": "Takes scratches, keys and drops, so your real screen stays like new." } },
        { "type": "card", "settings": { "icon": "touch", "title": "Full touch and Face ID", "text": "Smooth, fast touch response. Face ID and the front camera keep working normally." } },
        { "type": "card", "settings": { "icon": "sun", "title": "HD clear for you", "text": "Sharp and bright straight on. Anti-glare and anti-fingerprint coating built in." } }
      ]
    }
  ]
}
{% endschema %}
