{{ 'cs-privacy.css' | asset_url | stylesheet_tag }}

{%- assign p = section.settings.product -%}
<section class="cs cs--dark cs-cta" aria-label="{{ section.settings.heading | escape }}">
  <div class="cs-wrap cs-cta__grid">
    <div>
      <h2 class="cs-h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="cs-lead">{{ section.settings.text }}</p>{%- endif -%}
      <a class="cs-btn" href="{{ section.settings.cta_link | default: '#buy' }}">
        {{ section.settings.cta_label }}{% if p != blank %} &middot; {{ p.price | money }}{% endif %}
      </a>
      {%- if section.settings.micro != blank -%}<p class="cs-cta__micro">{{ section.settings.micro }}</p>{%- endif -%}
    </div>
    {%- if section.settings.image -%}
      <div class="cs-media cs-cta__img">
        {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 40vw, 100vw', widths: '500, 800, 1200', alt: section.settings.heading }}
      </div>
    {%- endif -%}
  </div>
</section>

{%- if section.settings.show_trust -%}
  <section class="cs cs-tfoot" aria-label="Store promises">
    <ul class="cs-wrap cs-tfoot__list">
      {%- for i in (1..4) -%}
        {%- capture tk %}t{{ i }}_title{% endcapture -%}
        {%- capture xk %}t{{ i }}_text{% endcapture -%}
        {%- if section.settings[tk] != blank -%}
          <li><strong>{{ section.settings[tk] }}</strong><span>{{ section.settings[xk] }}</span></li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </section>
{%- endif -%}

{%- if section.settings.sticky and p != blank -%}
  <a class="cs-sticky" href="#buy" data-cs-sticky>
    <span>{{ p.title | truncate: 34 }}</span>
    <strong>{{ section.settings.cta_label }} &middot; {{ p.price | money }}</strong>
  </a>
  <script>
    (function () {
      var s = document.querySelector('[data-cs-sticky]'), buy = document.getElementById('buy');
      if (!s || !buy || !('IntersectionObserver' in window)) return;
      new IntersectionObserver(function (e) {
        var past = e[0].boundingClientRect.top < 0 && !e[0].isIntersecting;
        s.classList.toggle('is-on', past);
      }).observe(buy);
    })();
  </script>
{%- endif -%}

<style>
  .cs-cta { background: linear-gradient(135deg, #0b0d12 0%, #16213d 100%); }
  .cs-cta__grid { display: grid; gap: 36px; align-items: center; }
  .cs-cta__micro { margin: 14px 0 0; font-size: 13px; opacity: .8; }
  .cs-cta__img { aspect-ratio: 1; }
  .cs-tfoot { padding: 36px 0; border-top: 1px solid var(--cs-line); }
  .cs-tfoot__list { list-style: none; display: grid; gap: 18px; grid-template-columns: repeat(2, 1fr); }
  .cs-tfoot__list li { display: grid; gap: 2px; font-size: 14px; }
  .cs-tfoot__list strong { color: var(--cs-ink); }
  .cs-sticky { position: fixed; left: 12px; right: 12px; bottom: 12px; z-index: 50; display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 12px 12px 12px 18px; border-radius: 999px; background: #0b0d12; color: #fff !important; text-decoration: none; font-size: 14px; box-shadow: 0 12px 30px rgba(0,0,0,.3); transform: translateY(140%); transition: transform .25s ease; }
  .cs-sticky strong { padding: 12px 18px; border-radius: 999px; background: #2f6bff; white-space: nowrap; }
  .cs-sticky.is-on { transform: none; }
  @media (min-width: 750px) { .cs-tfoot__list { grid-template-columns: repeat(4, 1fr); } .cs-sticky { left: auto; width: 460px; right: 24px; } }
  @media (min-width: 990px) { .cs-cta__grid { grid-template-columns: 1.2fr .8fr; gap: 64px; } }
</style>

{% schema %}
{
  "name": "CS Final CTA",
  "tag": "div",
  "settings": [
    { "type": "product", "id": "product", "label": "Product (for price)" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Stop angling your phone away from people." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Scroll, text and bank in public without checking who is looking. Two minutes to install. Years of privacy." },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Get my privacy glass" },
    { "type": "url", "id": "cta_link", "label": "Button link", "info": "Leave blank to scroll to the buy box." },
    { "type": "text", "id": "micro", "label": "Small print", "default": "Free shipping. 30-day returns. Secure checkout." },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "checkbox", "id": "sticky", "label": "Show sticky buy bar after the buy box", "default": true },
    { "type": "header", "content": "Trust strip (sits above your theme footer)" },
    { "type": "checkbox", "id": "show_trust", "label": "Show trust strip", "default": true },
    { "type": "text", "id": "t1_title", "label": "Point 1 title", "default": "Free shipping" },
    { "type": "text", "id": "t1_text", "label": "Point 1 text", "default": "On every US order" },
    { "type": "text", "id": "t2_title", "label": "Point 2 title", "default": "30-day returns" },
    { "type": "text", "id": "t2_text", "label": "Point 2 text", "default": "Not happy? Send it back" },
    { "type": "text", "id": "t3_title", "label": "Point 3 title", "default": "Secure checkout" },
    { "type": "text", "id": "t3_text", "label": "Point 3 text", "default": "Shop Pay, Apple Pay, cards" },
    { "type": "text", "id": "t4_title", "label": "Point 4 title", "default": "Real support" },
    { "type": "text", "id": "t4_text", "label": "Point 4 text", "default": "A person replies within 24 hours" }
  ],
  "presets": [ { "name": "CS Final CTA" } ]
}
{% endschema %}
