{{ 'cs-privacy.css' | asset_url | stylesheet_tag }}

<section class="cs cs--soft cs-det" aria-label="{{ section.settings.heading | escape }}">
  <div class="cs-wrap cs-det__grid">
    <div>
      {%- if section.settings.eyebrow != blank -%}<p class="cs-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="cs-h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.image -%}
        <div class="cs-media cs-det__img">
          {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 45vw, 100vw', widths: '500, 800, 1200', alt: section.settings.heading }}
        </div>
      {%- endif -%}
      {%- if section.settings.in_box != blank -%}
        <h3 class="cs-h3 cs-det__boxh">In the box</h3>
        <ul class="cs-checks">
          {%- assign items = section.settings.in_box | newline_to_br | split: '<br />' -%}
          {%- for i in items -%}{%- assign t = i | strip -%}{%- if t != blank -%}<li>{{ t }}</li>{%- endif -%}{%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    <div>
      <table class="cs-det__table">
        <tbody>
          {%- for block in section.blocks -%}
            <tr {{ block.shopify_attributes }}><th scope="row">{{ block.settings.label }}</th><td>{{ block.settings.value }}</td></tr>
          {%- endfor -%}
        </tbody>
      </table>

      {%- if section.settings.faq_1_q != blank or section.settings.faq_2_q != blank or section.settings.faq_3_q != blank -%}
        <div class="cs-det__faq">
          {%- for i in (1..3) -%}
            {%- capture qk %}faq_{{ i }}_q{% endcapture -%}
            {%- capture ak %}faq_{{ i }}_a{% endcapture -%}
            {%- if section.settings[qk] != blank -%}
              <details class="cs-det__q"{% if forloop.first %} open{% endif %}>
                <summary>{{ section.settings[qk] }}</summary>
                <div>{{ section.settings[ak] }}</div>
              </details>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

<style>
  .cs-det__grid { display: grid; gap: 36px; }
  .cs-det__img { aspect-ratio: 4 / 3; margin: 10px 0 28px; }
  .cs-det__boxh { margin-top: 8px; margin-bottom: 14px; }
  .cs-det__table { width: 100%; border-collapse: collapse; background: #fff; border-radius: var(--cs-radius); overflow: hidden; box-shadow: var(--cs-shadow); font-size: 15px; }
  .cs-det__table th, .cs-det__table td { padding: 16px 20px; text-align: left; border-bottom: 1px solid var(--cs-line); vertical-align: top; }
  .cs-det__table tr:last-child th, .cs-det__table tr:last-child td { border-bottom: 0; }
  .cs-det__table th { width: 42%; color: var(--cs-ink); font-weight: 800; }
  .cs-det__faq { display: grid; gap: 10px; margin-top: 24px; }
  .cs-det__q { background: #fff; border-radius: 14px; box-shadow: var(--cs-shadow); }
  .cs-det__q summary { list-style: none; cursor: pointer; padding: 18px 50px 18px 20px; font-weight: 800; color: var(--cs-ink); position: relative; }
  .cs-det__q summary::-webkit-details-marker { display: none; }
  .cs-det__q summary::after { content: "+"; position: absolute; right: 20px; top: 50%; transform: translateY(-50%); font-size: 22px; color: var(--cs-accent); transition: transform .2s; }
  .cs-det__q[open] summary::after { transform: translateY(-50%) rotate(45deg); }
  .cs-det__q > div { padding: 0 20px 18px; font-size: 15px; }
  .cs-det__q > div p { margin: 0; }
  @media (min-width: 990px) { .cs-det__grid { grid-template-columns: .9fr 1.1fr; gap: 64px; } }
</style>

{% schema %}
{
  "name": "CS Product details",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Product details" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Everything you want to know before you buy" },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Good spot for the what's-in-the-box flat lay." },
    { "type": "textarea", "id": "in_box", "label": "In the box (one item per line)", "default": "1 privacy tempered glass protector\nAuto-align installation frame\nWet and dry cleaning wipes\nDust removal stickers" },
    { "type": "text", "id": "faq_1_q", "label": "Question 1", "default": "Can I still see my screen clearly?" },
    { "type": "richtext", "id": "faq_1_a", "label": "Answer 1", "default": "<p>Yes. Straight on, it looks like a normal clear screen. You may want your brightness one notch higher in direct sun.</p>" },
    { "type": "text", "id": "faq_2_q", "label": "Question 2", "default": "Does it work with Face ID and my case?" },
    { "type": "richtext", "id": "faq_2_a", "label": "Answer 2", "default": "<p>Yes. The sensor area is left clear, and the edges are sized to fit under almost every case.</p>" },
    { "type": "text", "id": "faq_3_q", "label": "Question 3", "default": "What if I mess up the install?" },
    { "type": "richtext", "id": "faq_3_a", "label": "Answer 3", "default": "<p>The auto-align frame makes that hard to do. If it still goes wrong, message us and we will help you sort it out.</p>" }
  ],
  "blocks": [
    {
      "type": "spec", "name": "Spec row",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Material" },
        { "type": "text", "id": "value", "label": "Value", "default": "Tempered glass" }
      ]
    }
  ],
  "presets": [
    {
      "name": "CS Product details",
      "blocks": [
        { "type": "spec", "settings": { "label": "Material", "value": "Tempered privacy glass" } },
        { "type": "spec", "settings": { "label": "Hardness", "value": "9H surface hardness" } },
        { "type": "spec", "settings": { "label": "Thickness", "value": "0.33 mm" } },
        { "type": "spec", "settings": { "label": "Privacy angle", "value": "Dark beyond about 30 degrees to each side" } },
        { "type": "spec", "settings": { "label": "Adhesive", "value": "Full glue, full coverage" } },
        { "type": "spec", "settings": { "label": "Coating", "value": "Oil, fingerprint and glare resistant" } },
        { "type": "spec", "settings": { "label": "Compatibility", "value": "Made for each iPhone model. Pick yours in the buy box." } }
      ]
    }
  ]
}
{% endschema %}
