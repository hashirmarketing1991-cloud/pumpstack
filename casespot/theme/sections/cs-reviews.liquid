{{ 'cs-privacy.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign reviews = section.blocks | where: 'type', 'review'
  assign proofs = section.blocks | where: 'type', 'proof'
-%}
<section class="cs cs-rev" aria-label="{{ section.settings.heading | escape }}">
  <div class="cs-wrap">
    <div class="cs-head">
      {%- if section.settings.eyebrow != blank -%}<p class="cs-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="cs-h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="cs-lead">{{ section.settings.text }}</p>{%- endif -%}
    </div>

    {%- if proofs.size > 0 -%}
      <div class="cs-rev__proof">
        {%- for block in proofs -%}
          <figure class="cs-rev__fig" {{ block.shopify_attributes }}>
            <div class="cs-media cs-rev__img">
              {%- if block.settings.image -%}
                {{ block.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 50vw, 100vw', widths: '400, 700, 1000', alt: block.settings.caption }}
              {%- else -%}
                <div class="cs-placeholder">{{ 'image' | placeholder_svg_tag }}</div>
              {%- endif -%}
              {%- if block.settings.label != blank -%}<span class="cs-rev__label">{{ block.settings.label }}</span>{%- endif -%}
            </div>
            {%- if block.settings.caption != blank -%}<figcaption>{{ block.settings.caption }}</figcaption>{%- endif -%}
          </figure>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.reviews_app_html != blank -%}
      <div class="cs-rev__app">{{ section.settings.reviews_app_html }}</div>
    {%- endif -%}

    {%- if reviews.size > 0 -%}
      <div class="cs-rev__grid">
        {%- for block in reviews -%}
          <blockquote class="cs-rev__card" {{ block.shopify_attributes }}>
            <span class="cs-stars" aria-label="{{ block.settings.stars }} out of 5 stars">
              {%- for i in (1..5) -%}{% if i <= block.settings.stars %}&#9733;{% else %}&#9734;{% endif %}{%- endfor -%}
            </span>
            {%- if block.settings.title != blank -%}<p class="cs-rev__title">{{ block.settings.title }}</p>{%- endif -%}
            <p>{{ block.settings.body }}</p>
            <footer>
              {%- if block.settings.photo -%}{{ block.settings.photo | image_url: width: 96 | image_tag: loading: 'lazy', class: 'cs-rev__avatar', alt: block.settings.name }}{%- endif -%}
              <span><strong>{{ block.settings.name }}</strong>{% if block.settings.verified %} <em>Verified buyer</em>{% endif %}</span>
            </footer>
          </blockquote>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

<style>
  .cs-rev__proof { display: grid; gap: 18px; margin-bottom: 40px; }
  .cs-rev__fig { margin: 0; }
  .cs-rev__img { position: relative; aspect-ratio: 4 / 3; }
  .cs-rev__label { position: absolute; left: 14px; top: 14px; padding: 7px 12px; border-radius: 99px; background: rgba(11,13,18,.82); color: #fff; font-size: 13px; font-weight: 800; }
  .cs-rev__fig figcaption { margin-top: 10px; font-size: 14px; font-weight: 700; color: var(--cs-ink); text-align: center; }
  .cs-rev__app { margin-bottom: 32px; }
  .cs-rev__grid { display: grid; gap: 18px; }
  .cs-rev__card { margin: 0; padding: 24px; border: 1px solid var(--cs-line); border-radius: var(--cs-radius); background: #fff; }
  .cs-rev__card p { margin: 10px 0 0; font-size: 15px; }
  .cs-rev__title { font-weight: 800; color: var(--cs-ink); }
  .cs-rev__card footer { display: flex; align-items: center; gap: 10px; margin-top: 18px; font-size: 14px; color: var(--cs-ink); }
  .cs-rev__card em { font-style: normal; color: #007a61; font-size: 12px; font-weight: 800; }
  .cs-rev__avatar { width: 40px; height: 40px; border-radius: 50%; object-fit: cover; }
  @media (min-width: 750px) { .cs-rev__proof { grid-template-columns: repeat(2, 1fr); } .cs-rev__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 990px) { .cs-rev__grid { grid-template-columns: repeat(3, 1fr); } }
</style>

{% schema %}
{
  "name": "CS Proof and reviews",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "See it for yourself" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Clear to you. Black to everyone else." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Same phone, same screen, two angles. That is the whole point." },
    { "type": "html", "id": "reviews_app_html", "label": "Reviews app widget (optional)", "info": "Paste your Judge.me, Loox or Okendo widget code here to show live reviews." }
  ],
  "blocks": [
    {
      "type": "proof", "name": "Proof image", "limit": 4,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "label", "label": "Label on image", "default": "Front view" },
        { "type": "text", "id": "caption", "label": "Caption", "default": "You see everything" }
      ]
    },
    {
      "type": "review", "name": "Customer review",
      "settings": [
        { "type": "paragraph", "content": "Only add real reviews from real customers. Invented reviews break the FTC fake review rule." },
        { "type": "range", "id": "stars", "label": "Stars", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "body", "label": "Review" },
        { "type": "text", "id": "name", "label": "Name (first name + last initial)" },
        { "type": "image_picker", "id": "photo", "label": "Customer photo" },
        { "type": "checkbox", "id": "verified", "label": "Verified buyer", "default": true }
      ]
    }
  ],
  "presets": [
    {
      "name": "CS Proof and reviews",
      "blocks": [
        { "type": "proof", "settings": { "label": "Front view", "caption": "Face on: bright, sharp, normal screen" } },
        { "type": "proof", "settings": { "label": "Side view", "caption": "From the side: nothing to see here" } }
      ]
    }
  ]
}
{% endschema %}
