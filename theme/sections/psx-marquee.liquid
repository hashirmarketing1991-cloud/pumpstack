{% render 'psx-assets' %}
{%- if section.blocks.size > 0 -%}
  {%- capture group -%}
    {%- for i in (1..2) -%}
      {%- for block in section.blocks -%}
        <span class="psx-marquee__item" {% if i == 1 %}{{ block.shopify_attributes }}{% endif %}>{{ block.settings.text | escape }}{% render 'psx-spark' %}</span>
      {%- endfor -%}
    {%- endfor -%}
  {%- endcapture -%}
  {%- capture group_copy -%}
    {%- for i in (1..2) -%}
      {%- for block in section.blocks -%}
        <span class="psx-marquee__item">{{ block.settings.text | escape }}{% render 'psx-spark' %}</span>
      {%- endfor -%}
    {%- endfor -%}
  {%- endcapture -%}
  <section class="psx psx-marquee" style="--speed: {{ section.settings.speed }}s" aria-label="{{ section.settings.label | escape }}">
    <div class="psx-marquee__track">
      <div class="psx-marquee__group">{{ group }}</div>
      <div class="psx-marquee__group" aria-hidden="true">{{ group_copy }}</div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "PSX Marquee",
  "tag": "div",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "label", "label": "Label for screen readers", "default": "Store promises" },
    { "type": "range", "id": "speed", "label": "Time for one loop", "min": 16, "max": 80, "step": 4, "unit": "s", "default": 36 }
  ],
  "blocks": [
    { "type": "item", "name": "Line", "settings": [{ "type": "text", "id": "text", "label": "Text", "default": "Every dose on the label" }] }
  ],
  "presets": [
    {
      "name": "PSX Marquee",
      "blocks": [
        { "type": "item", "settings": { "text": "Free US shipping over $75" } },
        { "type": "item", "settings": { "text": "30-day money-back guarantee" } },
        { "type": "item", "settings": { "text": "Every dose on the label" } },
        { "type": "item", "settings": { "text": "Built to stack" } }
      ]
    }
  ]
}
{% endschema %}
