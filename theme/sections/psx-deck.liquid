{% render 'psx-assets' %}
{%- liquid
  assign collection = section.settings.collection
  assign limit = section.settings.limit
  assign count = 0
  if collection != blank
    assign count = collection.products_count | at_most: limit
  endif
-%}
<section class="psx psx-deck" data-psx-deck>
  <div class="psx-deck__inner">
    <div class="psx-deck__zone">
      <div class="psx-deck__head">
        <h2>
          {%- if section.settings.heading_dim != blank -%}<span class="psx-dim">{{ section.settings.heading_dim | escape }}</span>{%- endif -%}
          {%- if section.settings.heading != blank -%}<span>{{ section.settings.heading | escape }}</span>{%- endif -%}
        </h2>
      </div>

      <div class="psx-deck__cards">
        {%- if count > 0 -%}
          {%- for product in collection.products limit: limit -%}
            {%- liquid
              capture look
                render 'psx-product-look', product: product, index: forloop.index0, prefer_mockups: section.settings.prefer_mockups
              endcapture
              assign look = look | strip | split: '|'
              assign card = look[0]
              assign glow = look[1]
              assign asset = look[2]
              assign wide = look[3]

              assign title = product.title | remove_first: product.vendor | strip
              if title == blank
                assign title = product.title
              endif
              assign blurb = product.description | split: '</p>' | first | strip_html | strip
              if blurb == blank
                assign blurb = product.description | strip_html | truncatewords: 26
              endif
              assign number = forloop.index | prepend: '0' | slice: -2, 2
            -%}
            <article class="psx-card" style="--i: {{ forloop.index0 }}; --n: {{ count }}; --card: {{ card }}; --glow: {{ glow }};">
              <a class="psx-card__link" href="{{ product.url }}" tabindex="-1" aria-hidden="true"><span>{{ title | escape }}</span></a>
              <div class="psx-card__top">
                <span class="psx-card__num">({{ number }})</span>
                {%- if product.type != blank -%}<span class="psx-card__type">{{ product.type | escape }}</span>{%- endif -%}
              </div>
              <div class="psx-card__copy">
                <div>
                  <h3>{{ title | escape }}</h3>
                  {%- if blurb != blank -%}<p class="psx-card__desc">{{ blurb | escape }}</p>{%- endif -%}
                </div>
                <div class="psx-card__buy">
                  {%- if section.settings.show_price -%}
                    <span class="psx-card__price">
                      {{- product.price | money -}}
                      {%- if product.compare_at_price > product.price -%}<s>{{ product.compare_at_price | money }}</s>{%- endif -%}
                    </span>
                  {%- endif -%}
                  <a class="psx-btn psx-btn--light" href="{{ product.url }}" aria-label="{{ section.settings.button_label | escape }}: {{ title | escape }}">{{ section.settings.button_label | escape }}</a>
                </div>
              </div>
              <div class="psx-card__media">
                {%- if asset != blank -%}
                  <img class="{{ wide }}" src="{{ asset | asset_url }}" alt="{{ title | escape }}" loading="lazy" decoding="async">
                {%- elsif product.featured_media -%}
                  {{ product.featured_media | image_url: width: 1200 | image_tag:
                    widths: '480, 720, 960, 1200',
                    sizes: '(min-width: 750px) 40vw, 80vw',
                    loading: 'lazy',
                    alt: product.featured_media.alt | default: title
                  }}
                {%- endif -%}
              </div>
            </article>
          {%- endfor -%}
        {%- else -%}
          <article class="psx-card" style="--i: 0; --n: 1;">
            <div class="psx-card__top"><span class="psx-card__num">(01)</span></div>
            <div class="psx-card__copy"><div><h3>Choose a collection</h3><p class="psx-card__desc">Pick a collection in the section settings and each product in it becomes a card here.</p></div></div>
            <div class="psx-card__media"></div>
          </article>
        {%- endif -%}
      </div>
    </div>

    {%- if section.settings.all_label != blank and collection != blank -%}
      <div class="psx-deck__foot">
        <a class="psx-btn" href="{{ collection.url }}">{{ section.settings.all_label | escape }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "PSX Product deck",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading_dim", "label": "Heading, first line", "info": "Stays in view while the cards stack.", "default": "What we stack." },
    { "type": "text", "id": "heading", "label": "Heading, second line", "default": "One pouch at a time." },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Every card reads its title, type, first line of the description, price and link from the product." },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 2, "max": 10, "step": 1, "default": 8 },
    { "type": "checkbox", "id": "prefer_mockups", "label": "Use the built-in pouch images", "info": "Turn off to use each product's own first image when it has one.", "default": true },
    { "type": "checkbox", "id": "show_price", "label": "Show price", "default": true },
    { "type": "text", "id": "button_label", "label": "Card button label", "default": "Shop now" },
    { "type": "text", "id": "all_label", "label": "Button under the deck", "default": "Shop all products" }
  ],
  "presets": [{ "name": "PSX Product deck" }]
}
{% endschema %}
