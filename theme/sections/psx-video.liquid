{% render 'psx-assets' %}
{%- liquid
  assign video = section.settings.video
  assign cover = section.settings.cover
  assign ext_type = section.settings.video_url.type
  assign ext_id = section.settings.video_url.id

  comment
    On a product page the product's own metafields win: custom.video (file) or custom.video_url (link).
  endcomment
  if product
    assign own_video = product.metafields.custom.video.value
    assign own_link = product.metafields.custom.video_url.value
    if own_video != blank
      assign video = own_video
    elsif own_link != blank
      assign video = blank
      assign ext_type = blank
      assign ext_id = blank
      if own_link contains 'youtu.be/'
        assign ext_type = 'youtube'
        assign ext_id = own_link | split: 'youtu.be/' | last | split: '?' | first
      elsif own_link contains 'youtube.com/shorts/'
        assign ext_type = 'youtube'
        assign ext_id = own_link | split: 'shorts/' | last | split: '?' | first
      elsif own_link contains 'v='
        assign ext_type = 'youtube'
        assign ext_id = own_link | split: 'v=' | last | split: '&' | first
      elsif own_link contains 'vimeo.com/'
        assign ext_type = 'vimeo'
        assign ext_id = own_link | split: 'vimeo.com/' | last | split: '?' | first | split: '/' | last
      endif
    endif
  endif

  assign show = true
  if section.settings.hide_empty and video == blank and ext_id == blank
    assign show = false
  endif
-%}
{%- if show -%}
<section class="psx psx-video psx-video--{{ section.settings.shape }}">
  <div class="psx-video__panel">
    <div class="psx-video__copy">
      {%- if section.settings.eyebrow != blank -%}<p class="psx-eyebrow" data-psx-reveal>{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 data-psx-reveal>{{ section.settings.heading | escape }}</h2>{%- endif -%}
      {%- if section.settings.quote != blank -%}<blockquote class="psx-video__quote" data-psx-reveal style="--d: 1">{{ section.settings.quote | escape | newline_to_br }}</blockquote>{%- endif -%}
      {%- if section.settings.name != blank -%}
        <p class="psx-video__who" data-psx-reveal style="--d: 1">
          <span class="psx-review__name">{{ section.settings.name | escape }}</span>
          {%- if section.settings.detail != blank -%}<span class="psx-review__detail">{{ section.settings.detail | escape }}</span>{%- endif -%}
        </p>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <div class="psx-video__actions" data-psx-reveal style="--d: 2">
          <a class="psx-btn psx-btn--light" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }}</a>
        </div>
      {%- endif -%}
    </div>

    <div class="psx-video__frame" data-psx-video>
      {%- capture play -%}
        <span class="psx-video__icon"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M8 5.2v13.6a1 1 0 0 0 1.5.9l11-6.8a1 1 0 0 0 0-1.8l-11-6.8A1 1 0 0 0 8 5.200z"/></svg></span>
      {%- endcapture -%}

      {%- if video != blank -%}
        {{ video | video_tag: controls: false, preload: 'none', playsinline: true, image_size: '1080x', class: 'psx-video__media' }}
        <button class="psx-video__play" type="button" data-psx-play aria-label="{{ section.settings.play_label | escape }}">
          {%- if cover != blank -%}{{ cover | image_url: width: 1080 | image_tag: loading: 'lazy', alt: '' }}{%- endif -%}
          {{ play }}
        </button>
      {%- elsif ext_id != blank -%}
        {%- if cover != blank -%}
          {{ cover | image_url: width: 1080 | image_tag: class: 'psx-video__media', loading: 'lazy', alt: '' }}
        {%- elsif ext_type == 'youtube' -%}
          <img class="psx-video__media" src="https://i.ytimg.com/vi/{{ ext_id }}/hqdefault.jpg" alt="" loading="lazy">
        {%- endif -%}
        <button class="psx-video__play" type="button" data-psx-play aria-label="{{ section.settings.play_label | escape }}">{{ play }}</button>
        <template>
          {%- if ext_type == 'youtube' -%}
            <iframe class="psx-video__media" src="https://www.youtube-nocookie.com/embed/{{ ext_id }}?autoplay=1&playsinline=1&rel=0" title="{{ section.settings.heading | escape }}" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen></iframe>
          {%- else -%}
            <iframe class="psx-video__media" src="https://player.vimeo.com/video/{{ ext_id }}?autoplay=1&playsinline=1" title="{{ section.settings.heading | escape }}" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen></iframe>
          {%- endif -%}
        </template>
      {%- else -%}
        <div class="psx-video__empty">
          {{ play }}
          <p>Add your customer video in the theme editor.</p>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "PSX Video testimonial",
  "tag": "div",
  "settings": [
    { "type": "paragraph", "content": "Use a real customer video and their own words." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Video testimonial" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Hear it from them." },
    { "type": "textarea", "id": "quote", "label": "Quote", "default": "Add a line the customer says in this video." },
    { "type": "text", "id": "name", "label": "Customer name", "default": "Customer name" },
    { "type": "text", "id": "detail", "label": "Detail", "default": "Product they use" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop the lineup" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "header", "content": "Video" },
    { "type": "video", "id": "video", "label": "Video", "info": "Upload the file to Shopify. This is used first." },
    { "type": "video_url", "id": "video_url", "label": "Or a YouTube or Vimeo link", "accept": ["youtube", "vimeo"] },
    { "type": "image_picker", "id": "cover", "label": "Cover image", "info": "Shown before the video plays." },
    { "type": "checkbox", "id": "hide_empty", "label": "Hide this section when there is no video", "info": "On product pages the video comes from the product metafields Product video or Product video link.", "default": false },
    { "type": "select", "id": "shape", "label": "Video shape", "default": "portrait",
      "options": [{ "value": "portrait", "label": "Tall (phone video)" }, { "value": "square", "label": "Square" }, { "value": "landscape", "label": "Wide" }] },
    { "type": "text", "id": "play_label", "label": "Play button label for screen readers", "default": "Play video" }
  ],
  "presets": [{ "name": "PSX Video testimonial" }]
}
{% endschema %}
