{{ 'pump-stack.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign product = section.settings.product
  assign v = product.selected_or_first_available_variant
  assign save = 0
  if v.compare_at_price > v.price
    assign save = v.compare_at_price | minus: v.price
  endif
-%}
<section class="ps ps--dark ps-section ps-stack">
  <div class="ps-wrap">
    <div class="ps-stack__card">
      <div class="ps-stack__copy">
        {%- if section.settings.eyebrow != blank -%}<p class="ps-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="ps-h2">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}<p class="ps-lead">{{ section.settings.text }}</p>{%- endif -%}

        <ol class="ps-stack__steps">
          {%- for block in section.blocks -%}
            <li {{ block.shopify_attributes }}>
              <span class="ps-stack__when">{{ block.settings.when }}</span>
              <strong>{{ block.settings.title }}</strong>
              <span class="ps-stack__what">{{ block.settings.text }}</span>
            </li>
          {%- endfor -%}
        </ol>

        {%- if product != blank -%}
          <div class="ps-stack__buy">
            <div class="ps-price">
              <span class="ps-price__now">{{ v.price | money }}</span>
              {%- if save > 0 -%}
                <span class="ps-price__was">{{ v.compare_at_price | money }}</span>
                <span class="ps-price__save">You save {{ save | money }}</span>
              {%- endif -%}
            </div>
            {%- form 'product', product -%}
              <input type="hidden" name="id" value="{{ v.id }}">
              <button type="submit" class="ps-btn ps-btn--accent" {% unless v.available %}disabled{% endunless %}>
                {%- if v.available -%}{{ section.settings.button_label }}{%- else -%}Sold out{%- endif -%}
              </button>
            {%- endform -%}
          </div>
        {%- endif -%}
      </div>

      <div class="ps-stack__visual" aria-hidden="true">
        {%- if product.featured_media -%}
          {% render 'ps-product-visual', product: product, loading: 'lazy', sizes: '(min-width: 990px) 40vw, 90vw' %}
        {%- else -%}
          <div class="ps-stack__tubs">
            <div class="ps-stack__tub ps-stack__tub--l">{% render 'ps-tub-mock', name: 'Creatine', sub: 'Monohydrate', tone: 'bone' %}</div>
            <div class="ps-stack__tub ps-stack__tub--c">{% render 'ps-tub-mock', name: 'Pre-Workout', sub: 'Pump formula', tone: 'ink' %}</div>
            <div class="ps-stack__tub ps-stack__tub--r">{% render 'ps-tub-mock', name: 'Electrolyte', sub: 'Hydration', tone: 'accent' %}</div>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

<style>
  .ps-stack__card { display: grid; gap: clamp(28px, 4vw, 56px); align-items: center; border-radius: 28px; padding: clamp(24px, 5vw, 64px); background: linear-gradient(135deg, #1b1b1f, #0b0b0c 60%); border: 1px solid rgba(255,255,255,.08); position: relative; overflow: hidden; }
  .ps-stack__card::after { content: ""; position: absolute; right: -10%; top: -30%; width: 60%; aspect-ratio: 1; background: radial-gradient(closest-side, rgba(228,32,46,.28), transparent); pointer-events: none; }
  .ps-stack__steps { list-style: none; counter-reset: s; margin: 28px 0 0; padding: 0; display: grid; gap: 12px; }
  .ps-stack__steps li { display: grid; grid-template-columns: 96px 1fr; gap: 2px 14px; padding: 14px 16px; border-radius: var(--ps-radius); background: rgba(255,255,255,.05); }
  .ps-stack__when { grid-row: span 2; align-self: center; font-size: 11px; font-weight: 900; letter-spacing: .12em; text-transform: uppercase; color: var(--ps-accent); }
  .ps-stack__what { font-size: 14px; opacity: .7; }
  .ps-stack__buy { margin-top: 28px; display: flex; flex-wrap: wrap; align-items: center; gap: 16px 24px; }
  .ps-stack__buy .ps-price__now { font-size: 28px; }
  .ps-stack__tubs { position: relative; display: flex; justify-content: center; align-items: flex-end; padding: 6% 0; }
  .ps-stack__tub { width: 38%; filter: drop-shadow(0 24px 40px rgba(0,0,0,.5)); }
  .ps-stack__tub--l { transform: translateX(22%) scale(.86) rotate(-6deg); }
  .ps-stack__tub--c { position: relative; z-index: 2; width: 44%; }
  .ps-stack__tub--r { transform: translateX(-22%) scale(.86) rotate(6deg); }
  .ps-stack__visual img { width: 100%; border-radius: var(--ps-radius-lg); }
  @media (min-width: 990px) { .ps-stack__card { grid-template-columns: 1.1fr .9fr; } }
  @media (max-width: 989px) { .ps-stack__visual { order: -1; } .ps-stack__buy .ps-btn { flex: 1 1 100%; } }
</style>

{% schema %}
{
  "name": "PS Stack (bundle)",
  "settings": [
    { "type": "product", "id": "product", "label": "Bundle product" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Best value" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Full Pump Stack" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "The three products our customers stack most, in one box, for less." },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Get the full stack" }
  ],
  "blocks": [
    {
      "type": "step", "name": "Step", "limit": 4,
      "settings": [
        { "type": "text", "id": "when", "label": "When", "default": "Before" },
        { "type": "text", "id": "title", "label": "Product", "default": "Pre-Workout" },
        { "type": "text", "id": "text", "label": "What it does" }
      ]
    }
  ],
  "presets": [
    {
      "name": "PS Stack (bundle)",
      "blocks": [
        { "type": "step", "settings": { "when": "Before", "title": "Pre-Workout", "text": "Energy, focus and pump for the session ahead" } },
        { "type": "step", "settings": { "when": "During", "title": "Electrolyte Hydration", "text": "Replace what you sweat out, set after set" } },
        { "type": "step", "settings": { "when": "Every day", "title": "Creatine Monohydrate", "text": "Strength and power that builds over time" } }
      ]
    }
  ]
}
{% endschema %}
