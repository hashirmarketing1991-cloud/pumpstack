{% render 'psx-assets' %}
{%- assign rows = product.metafields.custom.story.value -%}
{%- if rows != blank -%}
  {%- liquid
    capture look
      render 'psx-product-look', product: product, index: 0, prefer_mockups: true
    endcapture
    assign look = look | strip | split: '|'
  -%}
  <section class="psx psx-story" style="--card: {{ look[0] }}; --glow: {{ look[1] }};">
    {%- if section.settings.heading != blank -%}
      <div class="psx-story__head">
        {%- if section.settings.eyebrow != blank -%}<p class="psx-eyebrow" data-psx-reveal>{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        <h2 data-psx-reveal>{{ section.settings.heading | escape }}</h2>
      </div>
    {%- endif -%}
    {%- for row in rows -%}
      <div class="psx-story__row{% cycle '', ' psx-story__row--flip' %}" data-psx-reveal>
        <div class="psx-story__media{% if row.image.value == blank %} psx-story__media--pouch{% endif %}">
          {%- if row.image.value != blank -%}
            {{ row.image.value | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '600, 900, 1400', sizes: '(min-width: 750px) 50vw, 100vw', alt: row.heading.value }}
          {%- elsif look[2] != blank -%}
            <img class="{{ look[3] }}" src="{{ look[2] | asset_url }}" alt="" loading="lazy">
          {%- endif -%}
        </div>
        <div class="psx-story__copy">
          <span class="psx-story__num">({{ forloop.index | prepend: '0' | slice: -2, 2 }})</span>
          <h3>{{ row.heading.value | escape }}</h3>
          {%- if row.text.value != blank -%}<p>{{ row.text.value | escape | newline_to_br }}</p>{%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </section>
{%- endif -%}

{% schema %}
{
  "name": "PSX Product story",
  "tag": "div",
  "settings": [
    { "type": "paragraph", "content": "Rows come from the product metafield Story blocks. A row without an image shows the product pouch." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The details" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What you get in every scoop." }
  ],
  "presets": [{ "name": "PSX Product story" }]
}
{% endschema %}
