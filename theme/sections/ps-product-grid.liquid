{{ 'pump-stack.css' | asset_url | stylesheet_tag }}

{%- assign collection = section.settings.collection -%}
<section class="ps ps--{{ section.settings.tone }} ps-section ps-grid">
  <div class="ps-wrap">
    <div class="ps-head ps-grid__head">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="ps-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="ps-h2">{{ section.settings.heading }}</h2>
      </div>
      {%- if collection != blank -%}
        <a class="ps-grid__all" href="{{ collection.url }}">View all <span aria-hidden="true">&rarr;</span></a>
      {%- endif -%}
    </div>

    <div class="ps-grid__list">
      {%- if collection != blank and collection.products_count > 0 -%}
        {%- for product in collection.products limit: section.settings.limit -%}
          {%- liquid
            assign v = product.selected_or_first_available_variant
            assign save = 0
            if v.compare_at_price > v.price
              assign save = v.compare_at_price | minus: v.price
            endif
          -%}
          <article class="ps-card">
            <a class="ps-card__media" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
              {% render 'ps-product-visual', product: product, loading: 'lazy', sizes: '(min-width: 990px) 25vw, 50vw' %}
              {%- if product.tags contains 'bundle' -%}
                <span class="ps-badge ps-badge--accent ps-card__badge">Best value</span>
              {%- elsif product.tags contains 'bestseller' -%}
                <span class="ps-badge ps-card__badge">Bestseller</span>
              {%- endif -%}
            </a>
            <div class="ps-card__body">
              <p class="ps-card__type">{{ product.type }}</p>
              <h3 class="ps-card__title"><a href="{{ product.url }}">{{ product.title | remove_first: 'Pump Stack ' }}</a></h3>
              <div class="ps-price">
                <span class="ps-price__now">{{ v.price | money }}</span>
                {%- if save > 0 -%}
                  <span class="ps-price__was">{{ v.compare_at_price | money }}</span>
                {%- endif -%}
              </div>
              {%- if product.has_only_default_variant or product.variants.size == 1 -%}
                {%- form 'product', product, class: 'ps-card__form' -%}
                  <input type="hidden" name="id" value="{{ v.id }}">
                  <button class="ps-btn ps-btn--ink ps-btn--block" type="submit" {% unless v.available %}disabled{% endunless %}>
                    {%- if v.available -%}Add to cart{%- else -%}Sold out{%- endif -%}
                  </button>
                {%- endform -%}
              {%- else -%}
                {%- form 'product', product, class: 'ps-card__form' -%}
                  <label class="visually-hidden" for="ps-v-{{ section.id }}-{{ product.id }}">Choose pack</label>
                  <select id="ps-v-{{ section.id }}-{{ product.id }}" name="id" class="ps-card__select">
                    {%- for variant in product.variants -%}
                      <option value="{{ variant.id }}" {% if variant == v %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>
                        {{ variant.title }} · {{ variant.price | money }}
                      </option>
                    {%- endfor -%}
                  </select>
                  <button class="ps-btn ps-btn--ink ps-btn--block" type="submit" {% unless product.available %}disabled{% endunless %}>
                    {%- if product.available -%}Add to cart{%- else -%}Sold out{%- endif -%}
                  </button>
                {%- endform -%}
              {%- endif -%}
            </div>
          </article>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..4) -%}
          <article class="ps-card">
            <div class="ps-card__media">{% render 'ps-tub-mock', name: 'Product', sub: 'Coming soon', tone: 'ink' %}</div>
            <div class="ps-card__body"><h3 class="ps-card__title">Select a collection</h3></div>
          </article>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

<style>
  .ps-grid__head { display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; }
  .ps-grid__all { font-weight: 800; font-size: 14px; letter-spacing: .06em; text-transform: uppercase; color: inherit; text-decoration: none; white-space: nowrap; border-bottom: 2px solid var(--ps-accent); padding-bottom: 2px; }
  .ps-grid__list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(12px, 2vw, 24px); }
  .ps-card { display: flex; flex-direction: column; background: #fff; border-radius: var(--ps-radius-lg); overflow: hidden; box-shadow: var(--ps-shadow); transition: transform .2s ease, box-shadow .2s ease; }
  .ps-card:hover { transform: translateY(-3px); box-shadow: 0 2px 4px rgba(0,0,0,.06), 0 18px 40px rgba(0,0,0,.10); }
  .ps-card__media { position: relative; display: grid; place-items: center; aspect-ratio: 1; background: var(--ps-sand); padding: 8%; }
  .ps-card__media img { width: 100%; height: 100%; object-fit: contain; }
  .ps-card__media .ps-tub { width: 88%; height: auto; }
  .ps-card__badge { position: absolute; top: 12px; left: 12px; }
  .ps-card__body { display: flex; flex-direction: column; gap: 8px; padding: 16px; flex: 1; }
  .ps-card__type { margin: 0; font-size: 11px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; opacity: .55; }
  .ps-card__title { margin: 0; font-size: clamp(15px, 1.5vw, 18px); font-weight: 800; line-height: 1.2; }
  .ps-card__title a { color: inherit; text-decoration: none; }
  .ps-card__form { margin-top: auto; display: grid; gap: 8px; padding-top: 6px; }
  .ps-card__select { width: 100%; min-height: 44px; border: 1px solid #d9d4c9; border-radius: 10px; padding: 0 12px; font: inherit; font-size: 14px; background: #fff; color: var(--ps-ink); }
  .ps-card .ps-btn { min-height: 48px; font-size: 13px; }
  @media (min-width: 990px) { .ps-grid__list { grid-template-columns: repeat({{ section.settings.columns }}, minmax(0, 1fr)); } }
  @media (max-width: 480px) { .ps-card__body { padding: 12px; } .ps-card .ps-btn { padding: 0 12px; } }
</style>

{% schema %}
{
  "name": "PS Product grid",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Shop the lineup" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Built for the pump" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 2, "max": 12, "step": 1, "default": 6 },
    { "type": "range", "id": "columns", "label": "Desktop columns", "min": 2, "max": 4, "step": 1, "default": 3 },
    { "type": "select", "id": "tone", "label": "Background", "default": "bone",
      "options": [{ "value": "bone", "label": "Bone" }, { "value": "white", "label": "White" }, { "value": "sand", "label": "Sand" }] }
  ],
  "presets": [{ "name": "PS Product grid" }]
}
{% endschema %}
