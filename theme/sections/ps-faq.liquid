{{ 'pump-stack.css' | asset_url | stylesheet_tag }}

<section class="ps ps--{{ section.settings.tone }} ps-section ps-faq">
  <div class="ps-wrap ps-faq__grid">
    <div>
      {%- if section.settings.eyebrow != blank -%}<p class="ps-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="ps-h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="ps-lead">{{ section.settings.text }}</p>{%- endif -%}
    </div>
    <div class="ps-faq__list">
      {%- for block in section.blocks -%}
        <details class="ps-faq__item" {{ block.shopify_attributes }} {% if forloop.first and section.settings.open_first %}open{% endif %}>
          <summary>{{ block.settings.question }}</summary>
          <div class="ps-faq__a">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {%- for block in section.blocks -%}
        {
          "@type": "Question",
          "name": {{ block.settings.question | json }},
          "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | json }} }
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
</script>

<style>
  .ps-faq__grid { display: grid; gap: 32px; }
  .ps-faq__list { display: grid; gap: 10px; }
  .ps-faq__item { background: #fff; border-radius: var(--ps-radius); box-shadow: var(--ps-shadow); color: var(--ps-ink); }
  .ps-faq__item summary { list-style: none; cursor: pointer; padding: 20px 56px 20px 22px; font-weight: 800; font-size: 16px; position: relative; }
  .ps-faq__item summary::-webkit-details-marker { display: none; }
  .ps-faq__item summary::after { content: "+"; position: absolute; right: 22px; top: 50%; transform: translateY(-50%); font-size: 24px; font-weight: 400; color: var(--ps-accent); transition: transform .2s ease; }
  .ps-faq__item[open] summary::after { transform: translateY(-50%) rotate(45deg); }
  .ps-faq__item summary:focus-visible { outline: 3px solid var(--ps-accent); outline-offset: 2px; border-radius: var(--ps-radius); }
  .ps-faq__a { padding: 0 22px 20px; line-height: 1.6; font-size: 15px; opacity: .8; }
  .ps-faq__a p { margin: 0 0 8px; }
  @media (min-width: 990px) { .ps-faq__grid { grid-template-columns: .8fr 1.2fr; gap: 64px; } }
</style>

{% schema %}
{
  "name": "PS FAQ",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Questions" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Before you buy" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Still not sure? Email us and a real person will reply within one business day." },
    { "type": "checkbox", "id": "open_first", "label": "Open first question", "default": true },
    { "type": "select", "id": "tone", "label": "Background", "default": "bone",
      "options": [{ "value": "bone", "label": "Bone" }, { "value": "white", "label": "White" }, { "value": "sand", "label": "Sand" }] }
  ],
  "blocks": [
    {
      "type": "qa", "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "How fast will I feel it?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Most people feel the pre-workout within 20 to 30 minutes.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "PS FAQ",
      "blocks": [
        { "type": "qa", "settings": { "question": "How fast will I feel the pre-workout?", "answer": "<p>Most people feel it 20 to 30 minutes after one scoop. If you are sensitive to caffeine, start with half a scoop.</p>" } },
        { "type": "qa", "settings": { "question": "Can I take the pre-workout and creatine together?", "answer": "<p>Yes. They are designed to stack. Mix creatine into your pre-workout, or take it any time of day. Consistency matters more than timing.</p>" } },
        { "type": "qa", "settings": { "question": "Is it third-party tested?", "answer": "<p>Yes. Every batch is tested by an independent lab before it ships.</p>" } },
        { "type": "qa", "settings": { "question": "What if it does not work for me?", "answer": "<p>You are covered by our 30-day money-back guarantee. Email us and we will sort out a refund.</p>" } },
        { "type": "qa", "settings": { "question": "How long does shipping take?", "answer": "<p>Orders ship within 1 to 2 business days. Most US orders arrive in 3 to 5 business days. Shipping is free on orders over $75.</p>" } },
        { "type": "qa", "settings": { "question": "Is Pump Stack safe for me?", "answer": "<p>Our products are for healthy adults 18 and over. If you are pregnant, nursing, have a medical condition or take medication, talk to your doctor first.</p>" } }
      ]
    }
  ]
}
{% endschema %}
