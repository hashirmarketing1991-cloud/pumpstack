{% render 'psx-assets' %}
{%- liquid
  assign own = product.metafields.custom.faq.value
  assign has = false
  if own != blank or section.blocks.size > 0
    assign has = true
  endif
-%}
{%- if has -%}
  <section class="psx psx-faq">
    <div class="psx-faq__inner">
      {%- if section.settings.eyebrow != blank -%}<p class="psx-eyebrow" data-psx-reveal>{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 data-psx-reveal>{{ section.settings.heading | escape }}</h2>{%- endif -%}
      <div class="psx-acc psx-acc--large">
        {%- if own != blank -%}
          {%- for item in own -%}
            <details>
              <summary>{{ item.question.value | escape }}</summary>
              <div class="psx-acc__body">{{ item.answer.value | escape | newline_to_br }}</div>
            </details>
          {%- endfor -%}
        {%- endif -%}
        {%- for block in section.blocks -%}
          <details {{ block.shopify_attributes }}>
            <summary>{{ block.settings.question | escape }}</summary>
            <div class="psx-acc__body psx-rte">{{ block.settings.answer }}</div>
          </details>
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "PSX FAQ",
  "tag": "div",
  "max_blocks": 12,
  "settings": [
    { "type": "paragraph", "content": "Questions from the product metafield FAQ show first. Questions added here show on every product." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Questions" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Good to know." }
  ],
  "blocks": [
    {
      "type": "qa",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "How long does shipping take?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Add the answer here.</p>" }
      ]
    }
  ],
  "presets": [{ "name": "PSX FAQ", "blocks": [{ "type": "qa" }] }]
}
{% endschema %}
