{% render 'psx-assets' %}
{% render 'psx-font', font: section.settings.font %}
{%- assign lines = section.settings.heading | newline_to_br | split: '<br />' -%}

<section class="psx psx-hero" data-psx-hero aria-label="{{ section.settings.heading | strip_newlines | escape }}">
  <div class="psx-hero__top">
    <h1 class="psx-hero__title">
      {%- for line in lines -%}
        {%- assign text = line | strip -%}
        {%- if text == blank -%}{%- continue -%}{%- endif -%}
        <span class="psx-line" style="--l: {{ forloop.index0 }}"><span>{{ text | escape }}{% if forloop.first and section.settings.show_mark %} {% render 'psx-spark' %}{% endif %}</span></span>
      {%- endfor -%}
    </h1>
    {%- if section.settings.subheading != blank -%}
      <p class="psx-hero__sub">{{ section.settings.subheading | escape }}</p>
    {%- endif -%}
    <div class="psx-hero__cta">
      {%- if section.settings.cta_label != blank -%}
        <a class="psx-btn" href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}">{{ section.settings.cta_label | escape }}</a>
      {%- endif -%}
      {%- if section.settings.cta2_label != blank -%}
        <a class="psx-link" href="{{ section.settings.cta2_link | default: routes.all_products_collection_url }}">{{ section.settings.cta2_label | escape }}</a>
      {%- endif -%}
    </div>
  </div>

  {%- if section.blocks.size > 0 -%}
    <div class="psx-hero__stats">
      {%- for block in section.blocks limit: 2 -%}
        <div class="psx-stat" {{ block.shopify_attributes }}>
          <small>{{ block.settings.label | escape }}</small>
          <b>{{ block.settings.value | escape }}</b>
        </div>
      {%- endfor -%}
    </div>
  {%- endif -%}

  <div class="psx-hero__stage">
    <div class="psx-hero__pin">
      <div class="psx-hero__card">
        <div class="psx-hero__copy">
          {%- if section.settings.card_heading != blank -%}<h2>{{ section.settings.card_heading | escape }}</h2>{%- endif -%}
          {%- if section.settings.card_text != blank -%}<p>{{ section.settings.card_text | escape }}</p>{%- endif -%}
        </div>
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 2400 | image_tag:
            class: 'psx-hero__img',
            widths: '900, 1400, 1900, 2400',
            sizes: '(min-width: 750px) 92vw, 100vw',
            loading: 'eager',
            fetchpriority: 'high',
            alt: section.settings.image.alt | default: section.settings.card_heading
          }}
        {%- else -%}
          {%- comment -%} Phones get a taller group shot so every product stays in view. {%- endcomment -%}
          <picture>
            <source media="(max-width: 749px)" srcset="{{ 'ps-pouch-stack-mobile.webp' | asset_url }}" width="1148" height="1550">
            <img class="psx-hero__img" src="{{ 'ps-pouch-lineup.webp' | asset_url }}" width="2400" height="582" alt="{{ section.settings.card_heading | escape }}" loading="eager" fetchpriority="high">
          </picture>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "PSX Hero",
  "tag": "div",
  "max_blocks": 2,
  "settings": [
    { "type": "header", "content": "Headline" },
    { "type": "textarea", "id": "heading", "label": "Heading", "info": "Each line slides in on its own.", "default": "From regimen\nto supplement" },
    { "type": "checkbox", "id": "show_mark", "label": "Show the spark after the first line", "default": true },
    { "type": "textarea", "id": "subheading", "label": "Text", "default": "Clean formulas that fit the way you already train. Every dose is printed on the pouch." },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Shop the lineup" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "text", "id": "cta2_label", "label": "Second link label", "default": "See the full stack" },
    { "type": "url", "id": "cta2_link", "label": "Second link" },
    { "type": "header", "content": "Growing card" },
    { "type": "text", "id": "card_heading", "label": "Card heading", "default": "Everything you train with." },
    { "type": "textarea", "id": "card_text", "label": "Card text", "default": "Protein, creatine, pre-workout and hydration. One brand, one routine." },
    { "type": "image_picker", "id": "image", "label": "Card image", "info": "Leave empty to use the built-in pouch lineup. A wide image on a transparent background works best." },
    { "type": "header", "content": "Type" },
    { "type": "font_picker", "id": "font", "label": "Font for the psx sections", "default": "poppins_n8" }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Protein per scoop" },
        { "type": "text", "id": "value", "label": "Value", "default": "27g" }
      ]
    }
  ],
  "presets": [
    {
      "name": "PSX Hero",
      "blocks": [
        { "type": "stat", "settings": { "label": "Protein per scoop", "value": "27g" } },
        { "type": "stat", "settings": { "label": "Creatine per serving", "value": "5g" } }
      ]
    }
  ]
}
{% endschema %}
