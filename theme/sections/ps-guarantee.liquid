{{ 'pump-stack.css' | asset_url | stylesheet_tag }}

<section class="ps ps--{{ section.settings.tone }} ps-section--tight ps-guarantee">
  <div class="ps-wrap ps-guarantee__inner">
    <div class="ps-guarantee__seal" aria-hidden="true">
      <span class="ps-guarantee__big">{{ section.settings.days }}</span>
      <span class="ps-guarantee__small">Day<br>guarantee</span>
    </div>
    <div>
      <h2 class="ps-h2">{{ section.settings.heading }}</h2>
      <p class="ps-lead">{{ section.settings.text }}</p>
    </div>
  </div>
</section>

<style>
  .ps-guarantee__inner { display: grid; gap: 24px; align-items: center; justify-items: start; }
  .ps-guarantee__seal { width: 132px; height: 132px; border-radius: 50%; display: grid; place-content: center; text-align: center; background: var(--ps-ink); color: #fff; outline: 3px dashed var(--ps-accent); outline-offset: 6px; }
  .ps--dark .ps-guarantee__seal { background: var(--ps-accent); outline-color: #fff; }
  .ps-guarantee__big { font-size: 48px; font-weight: 900; line-height: 1; }
  .ps-guarantee__small { font-size: 11px; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; margin-top: 4px; }
  @media (min-width: 750px) { .ps-guarantee__inner { grid-template-columns: auto 1fr; gap: 48px; } }
</style>

{% schema %}
{
  "name": "PS Guarantee",
  "settings": [
    { "type": "text", "id": "days", "label": "Days", "default": "30" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Try it. Feel it. Or get your money back." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Give Pump Stack 30 days. If you do not feel the difference in your training, email us and we will refund you. No forms, no runaround." },
    { "type": "select", "id": "tone", "label": "Background", "default": "sand",
      "options": [{ "value": "sand", "label": "Sand" }, { "value": "bone", "label": "Bone" }, { "value": "dark", "label": "Dark" }] }
  ],
  "presets": [{ "name": "PS Guarantee" }]
}
{% endschema %}
